{
    "name": "@commerce-flow/inventory-service",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "scripts": {
        "dev": "tsx src/index.ts",
        "db:init": "tsx src/initializeDatabase.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tests/tsconfig.json --noEmit",
        "test": "node --import tsx --test tests/inventoryService.test.ts tests/inventoryApp.test.ts tests/paymentAuthorizedHandler.test.ts tests/config.test.ts tests/databaseReadiness.test.ts",
        "test:integration": "node --import tsx --test tests/*.integration.test.ts"
    },
    "dependencies": {
        "@commerce-flow/contracts": "file:../../shared/contracts",
        "@commerce-flow/logging": "file:../../shared/logging",
        "@commerce-flow/messaging": "file:../../shared/messaging",
        "@commerce-flow/persistence": "file:../../shared/persistence",
        "@commerce-flow/runtime": "file:../../shared/runtime",
        "express": "^4.18.3",
        "pg": "^8.23.0"
    },
    "devDependencies": {
        "@commerce-flow/testing": "file:../../shared/testing",
        "amqplib": "^0.10.5",
        "@types/pg": "^8.23.1"
    }
}
