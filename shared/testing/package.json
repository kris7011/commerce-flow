{
    "name": "@commerce-flow/testing",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "production": "./dist/index.js",
            "import": "./src/index.ts"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tests/tsconfig.json --noEmit",
        "test": "node --import tsx --test tests/testDatabase.test.ts",
        "test:integration": "node --import tsx --test tests/testDatabase.integration.test.ts"
    },
    "dependencies": {
        "pg": "^8.23.0"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1"
    }
}
