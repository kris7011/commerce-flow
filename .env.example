# Example configuration for local development. Every value has a
# development default, so copying this file is optional. Never commit a
# real .env file; with NODE_ENV=production, DATABASE_URL and
# RABBITMQ_URL must be set explicitly.

# Infrastructure (docker compose)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
POSTGRES_USER=commerce_flow
POSTGRES_PASSWORD=commerce_flow

# Services
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DATABASE_URL=postgresql://commerce_flow:commerce_flow@localhost:5432/commerce_flow

ORDER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
DELIVERY_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Inventory outbox relay and publisher confirms
RABBITMQ_PUBLISH_TIMEOUT_MS=10000
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000

# Tests
TEST_DATABASE_ADMIN_URL=postgresql://commerce_flow:commerce_flow@localhost:5432/postgres
RABBITMQ_MANAGEMENT_URL=http://guest:guest@localhost:15672
