{
  "name": "commerce-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven microservice backend demo for an e-commerce order flow.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared/contracts",
    "shared/messaging",
    "shared/logging",
    "shared/testing",
    "shared/runtime",
    "services/order-service",
    "services/payment-service",
    "services/inventory-service",
    "services/delivery-service",
    "services/notification-service",
    "tools/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:e2e",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "typecheck:e2e": "tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration:testing && npm run test:integration:rabbitmq && npm run test:integration:order && npm run test:integration:inventory",
    "test:integration:order": "npm run test:integration --workspace=@commerce-flow/order-service",
    "test:integration:testing": "npm run test:integration --workspace=@commerce-flow/testing",
    "test:integration:rabbitmq": "npm run test:integration --workspace=@commerce-flow/messaging",
    "test:integration:inventory": "npm run test:integration --workspace=@commerce-flow/inventory-service",
    "test:e2e": "npm run test:e2e:workflow && npm run test:e2e:reliability && npm run test:e2e:recovery",
    "test:e2e:workflow": "node --import tsx --test tests/e2e/commerceFlow.e2e.test.ts",
    "test:e2e:reliability": "node --import tsx --test tests/e2e/inventoryReliability.e2e.test.ts",
    "test:e2e:recovery": "node --import tsx --test tests/e2e/rabbitMqRecovery.e2e.test.ts",
    "dev:order": "npm run dev --workspace=@commerce-flow/order-service",
    "dev:payment": "npm run dev --workspace=@commerce-flow/payment-service",
    "dev:inventory": "npm run dev --workspace=@commerce-flow/inventory-service",
    "dev:delivery": "npm run dev --workspace=@commerce-flow/delivery-service",
    "dev:notification": "npm run dev --workspace=@commerce-flow/notification-service",
    "demo": "node --import tsx tools/cli/src/demo.ts",
    "status": "node --import tsx tools/cli/src/status.ts",
    "trace": "node --import tsx tools/cli/src/trace.ts",
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:down": "docker compose --profile app down"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@commerce-flow/testing": "file:shared/testing",
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "amqplib": "^0.10.5",
    "eslint": "^10.12.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  }
}
